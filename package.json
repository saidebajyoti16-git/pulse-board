{
  "name": "pulse-board",
  "private": true,
  "version": "4.0.0",
  "description": "Pulse Board \u2014 GitHub and Vercel ready digital signage management system",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "install:client": "npm --prefix client install",
    "postinstall": "npm --prefix client install",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "preview": "npm --prefix client run preview"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/blob": "^2.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
