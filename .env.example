# Required for Vercel production deployment
# Create a PostgreSQL database integration in Vercel (Neon or Supabase).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Generate a random string with at least 32 characters.
PULSE_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
# Used only when the cloud database initializes for the first time.
PULSE_ADMIN_USERNAME=admin
PULSE_ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-12-characters
# Automatically provided when you attach a Vercel Blob store to the project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me
